# Execution target: dev | qa | uat
TEST_ENV=qa

# Public demo targets can be replaced with organisation-specific endpoints.
BASE_URL=https://www.saucedemo.com
API_BASE_URL=https://jsonplaceholder.typicode.com

# Supply at runtime. Never commit real credentials.
TEST_USERNAME=
TEST_PASSWORD=

HEADLESS=true
LOG_LEVEL=info
WORKERS=4

# Optional projects
ENABLE_EDGE=false
ENABLE_MOBILE=false

# Configurable release gate
QUALITY_GATE_MIN_PASS_RATE=98
QUALITY_GATE_SMOKE_MIN_PASS_RATE=100
QUALITY_GATE_MAX_CRITICAL_FAILURES=0
QUALITY_GATE_MAX_CRITICAL_A11Y=0
