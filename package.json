{
  "name": "playwright-enterprise-test-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise-grade Quality Engineering reference implementation using Playwright and TypeScript.",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "test": "playwright test --project=chromium --project=api",
    "test:all": "playwright test",
    "test:dev": "cross-env TEST_ENV=dev playwright test --project=chromium --project=api",
    "test:qa": "cross-env TEST_ENV=qa playwright test --project=chromium --project=api",
    "test:uat": "cross-env TEST_ENV=uat playwright test --project=chromium --project=api",
    "test:smoke": "playwright test --project=chromium --grep @smoke",
    "test:regression": "playwright test --project=chromium --grep @regression",
    "test:api": "playwright test --project=api",
    "test:api:local": "cross-env USE_LOCAL_API=true playwright test --project=api",
    "test:integration": "playwright test --project=chromium tests/integration",
    "test:accessibility": "playwright test --project=chromium tests/ui/accessibility",
    "test:visual": "playwright test --project=chromium tests/visual",
    "test:headed": "cross-env HEADLESS=false playwright test --project=chromium --headed",
    "test:debug": "playwright test --project=chromium --debug",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:edge": "cross-env ENABLE_EDGE=true playwright test --project=edge",
    "test:mobile": "cross-env ENABLE_MOBILE=true playwright test --project=mobile-chrome",
    "test:cross-browser": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:shard:1": "playwright test --project=chromium --shard=1/3",
    "test:shard:2": "playwright test --project=chromium --shard=2/3",
    "test:shard:3": "playwright test --project=chromium --shard=3/3",
    "test:allure": "cross-env ALLURE_REPORT=true playwright test --project=chromium --project=api",
    "report": "playwright show-report",
    "quality-gate": "tsx scripts/quality-gate.ts",
    "validate:env": "tsx scripts/validate-env.ts",
    "validate:workflows": "tsx scripts/validate-workflows.ts",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm run validate:workflows",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "tsx scripts/clean-results.ts"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "pino": "^9.14.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "^22.20.1",
    "allure-playwright": "^3.10.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.1",
    "eslint-plugin-playwright": "^2.11.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "yaml": "^2.9.0"
  }
}
